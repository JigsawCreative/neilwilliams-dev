# Node modules and dependencies
node_modules/

# Temporary files
temp/

# Build and cache outputs
dist/
build/
.cache/
.vite/

# OS and editor files
.DS_Store
Thumbs.db
*.log
*.tmp

# VS Code settings
.vscode/

# SASS/SCSS cache
.sass-cache/

# Composer dependencies (if used)
vendor/

# Environment and config
.env
.env.*

# WordPress uploads and generated files (if any are in theme)
uploads/

# Local config and debug
wp-config-local.php
debug.log

# Mac system files
Icon?

# Ignore compiled CSS/JS if built from source
assets/css/*.css
assets/js/*.js
!assets/css/style.min.css
!assets/js/scripts.min.js

# Ignore map files
*.map

# Ignore PHPStorm and JetBrains IDEs
.idea/

# Ignore npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore package lock files (optional, if you don't want to commit them)
package-lock.json
yarn.lock

# Ignore backup files
*~
*.bak
*.swp
*.swo

# Ignore test coverage
coverage/